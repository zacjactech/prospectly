# Prospectly configuration — copy to `.env` and fill in as needed.
# NEVER commit `.env` (it is gitignored). Keys are read only from env/.env (D8).

# --- App ---
BIND_HOST=127.0.0.1
BIND_PORT=8000
# APP_ACCESS_TOKEN=            # REQUIRED if BIND_HOST is anything other than 127.0.0.1 / localhost

# --- Phone normalization ---
# ISO-3166 alpha-2 country used when a number has no country code (e.g. US, GB, NG).
# Unset = numbers must be in international format (+... / 00...).
# PHONE_DEFAULT_COUNTRY=

# --- Database ---
# Defaults to sqlite:///<project>/data/prospectly.db (absolute, created on first run).
# DATABASE_URL=sqlite:///C:/Users/you/Documents/Prospectly/data/prospectly.db

# --- Discovery providers ---
# OSM Overpass needs no key and is enabled by default.
# OSM_ENABLED=true

# --- Search providers (optional; leaving a key unset disables that provider) ---
# TAVILY_API_KEY=
# SERPER_API_KEY=
# BRAVE_API_KEY=

# --- AI (optional) ---
# template = zero-key fallback that drafts from findings using placeholders (default floor).
# Options: template | gemini | groq | openrouter | ollama
AI_PROVIDER=template
AI_MODEL=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Provider safety caps (hard stops before surprise usage) ---
TAVILY_DAILY_CAP=1000
SERPER_DAILY_CAP=500
AI_DAILY_CAP=200
